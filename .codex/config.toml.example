# Codex configuration template
# To use this locally, copy this file to config.toml in the same folder and customize it.

model_provider = "openai"       # e.g., "openai", "litellm", or "azure"
model = "gpt-4o"
review_model = "gpt-4o""
model_reasoning_effort = "xhigh"
disable_response_storage = true
network_access = "enabled"
windows_wsl_setup_acknowledged = true

[features]
web_search = true               # Enable/disable web search capability
codex_git_commit = true         # Allow Codex to author git commits
goals = true

[model_providers.openai]
# Custom gateway or API settings (optional)
# base_url = "https://api.openai.com/v1"
# wire_api = "responses"
# requires_openai_auth = true