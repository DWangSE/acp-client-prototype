# ====================================================================
# Universal ACP Client — Environment Variables
# ====================================================================
# Copy this file to .env and fill in your API keys.
#
#   cp .env.example .env
#   # Edit .env with your keys
#   npm install
#   npm run hello -- <agent-id>
#
# Common commands:
#   npm run hello -- gemini         # Google Gemini CLI
#   npm run hello -- claude         # Claude Code
#   npm run hello -- codex          # OpenAI Codex
#   npm run hello -- goose          # Goose (Block/Square)
#   npm run hello -- opencode       # OpenCode
#   npm run hello -- kimi           # Moonshot Kimi
#   npm run hello -- mistral-vibe   # Mistral Vibe
#   npm run hello -- --list         # List all agents
#   npm run hello -- --check        # Check which agents are ready
#
# ====================================================================

# ── Proxy (if behind a firewall/VPN) ──
# HTTPS_PROXY=http://127.0.0.1:7890

# ── Debug ──
VERBOSE=0

# ====================================================================
# P0: Core Agents (recommended to set up)
# ====================================================================

# Google — Gemini CLI
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Anthropic — Claude Code
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — Codex CLI
# Get key: https://platform.openai.com/
OPENAI_API_KEY=sk-...

# ====================================================================
# P1: Extended Agents
# ====================================================================

# GitHub — Copilot CLI (requires Copilot subscription)
# GITHUB_TOKEN=ghp_...

# Moonshot AI — Kimi CLI
# Get key: https://platform.moonshot.cn/
# MOONSHOT_API_KEY=sk-...

# Mistral AI — Mistral Vibe
# Get key: https://console.mistral.ai/
# MISTRAL_API_KEY=...

# Zhipu AI — GLM Agent
# Get key: https://open.bigmodel.cn/
# ZHIPU_API_KEY=...

# Alibaba — Qwen Code
# Get key: https://dashscope.console.aliyun.com/
# DASHSCOPE_API_KEY=sk-...

# Augment Code — Auggie CLI
# AUGMENT_API_KEY=...

# Factory AI — Factory Droid
# FACTORY_API_KEY=...

# Cursor
# CURSOR_API_KEY=...

# ====================================================================
# Goose (Block/Square) — Pre-configured
# ====================================================================
# Goose uses "pre-configured" auth — run "goose configure" first.
# These env vars override the configured provider:
# GOOSE_PROVIDER=openai
# GOOSE_MODEL=gpt-4o

# ====================================================================
# OpenCode — Pre-configured
# ====================================================================
# OpenCode uses "pre-configured" auth — run "opencode login" first.

# ====================================================================
# Override Commands (advanced)
# ====================================================================
# If you have an agent installed globally or locally, override npx:
#
# GEMINI_CLI_COMMAND=gemini
# GEMINI_CLI_ARGS=--acp
#
# CLAUDE_CLI_COMMAND=npx
# CLAUDE_CLI_ARGS=-y @agentclientprotocol/claude-agent-acp
#
# GOOSE_CLI_COMMAND=goose
# GOOSE_CLI_ARGS=acp
