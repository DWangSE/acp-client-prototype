# ====================================================================
# Universal ACP Client — Environment Variables
# ====================================================================
# Copy this file to .env and fill in your API keys.
#
#   cp .env.example .env
#   # Edit .env with your keys
#   npm install
#   npm run hello -- <agent-id>
#
# Common commands:
#   npm run hello -- gemini         # Google Gemini CLI
#   npm run hello -- claude         # Claude Code
#   npm run hello -- codex          # OpenAI Codex
#   npm run hello -- codebuddy      # Tencent CodeBuddy
#   npm run hello -- goose          # Goose (Block/Square)
#   npm run hello -- opencode       # OpenCode
#   npm run hello -- kimi           # Moonshot Kimi
#   npm run hello -- mistral-vibe   # Mistral Vibe
#   npm run hello -- --list         # List all agents
#   npm run hello -- --check        # Check which agents are ready
#
# ====================================================================

# ── Proxy (if behind a firewall/VPN) ──
# HTTPS_PROXY=http://127.0.0.1:7890

# ── Debug ──
VERBOSE=0

# ====================================================================
# P0: Core Agents (recommended to set up)
# ====================================================================

# Google — Gemini CLI
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Custom base URL / Endpoint (optional, to route through proxies)
# GOOGLE_GEMINI_BASE_URL=https://my-proxy.com/v1
# GOOGLE_VERTEX_BASE_URL=https://my-vertex-proxy.com

# Anthropic — Claude Code
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Custom base URL / Endpoint (optional, e.g., OpenRouter or proxy)
# ANTHROPIC_BASE_URL=https://openrouter.ai/api

# OpenAI — Codex CLI
# Get key: https://platform.openai.com/
OPENAI_API_KEY=sk-...
# Custom base URL / Endpoint (optional, e.g., OpenRouter or proxy)
# Note: Codex is a pre-compiled Rust binary and ignores OPENAI_BASE_URL.
# Instead, you can point CODEX_HOME to a local directory to fully override endpoints locally.
# CODEX_HOME=./.codex
# If using CODEX_HOME=./.codex, create a folder named `.codex` in your project root,
# and place `config.toml` and `auth.json` inside it. See README for details.

# ====================================================================
# P1: Extended Agents
# ====================================================================

# GitHub — Copilot CLI (requires Copilot subscription)
# COPILOT_GITHUB_TOKEN= # Recommended (fine-grained PAT with 'Copilot Requests' permissions)
# GH_TOKEN=             # Optional fallback
# GITHUB_TOKEN=         # Optional fallback (e.g. ghp_...)

# Moonshot AI — Kimi CLI
# Get key: https://platform.moonshot.cn/
# MOONSHOT_API_KEY=sk-...

# Tencent — CodeBuddy Code
# Get key: https://cloud.tencent.com/
# CODEBUDDY_API_KEY=sk-...
# Custom base URL / Environment (optional)
# CODEBUDDY_BASE_URL=https://tencent.sso.copilot.tencent.com
# CODEBUDDY_INTERNET_ENVIRONMENT=public # public | internal | ioa

# Mistral AI — Mistral Vibe
# Get key: https://console.mistral.ai/
# MISTRAL_API_KEY=...

# Zhipu AI — GLM Agent
# Get key: https://open.bigmodel.cn/
# ZHIPU_API_KEY=...

# Alibaba — Qwen Code
# Get key: https://dashscope.console.aliyun.com/
# DASHSCOPE_API_KEY=sk-...

# Augment Code — Auggie CLI
# AUGMENT_API_KEY=...

# Factory AI — Factory Droid
# FACTORY_API_KEY=...

# Cursor
# CURSOR_API_KEY=...

# ====================================================================
# Goose (Block/Square) — Pre-configured
# ====================================================================
# Goose uses "pre-configured" auth — run "goose configure" first.
# These env vars override the configured provider:
# GOOSE_PROVIDER=openai
# GOOSE_MODEL=gpt-4o
# Custom OpenAI endpoint host & path (optional)
# OPENAI_HOST=https://api.groq.com/openai/v1
# OPENAI_BASE_PATH=v1/chat/completions

# ====================================================================
# OpenCode — Pre-configured
# ====================================================================
# OpenCode uses "pre-configured" auth — run "opencode login" first.

# ====================================================================
# Override Commands (advanced)
# ====================================================================
# If you have an agent installed globally or locally, override npx:
#
# GEMINI_CLI_COMMAND=gemini
# GEMINI_CLI_ARGS=--acp
#
# CLAUDE_CLI_COMMAND=npx
# CLAUDE_CLI_ARGS=-y @agentclientprotocol/claude-agent-acp
#
# CODEBUDDY_CLI_COMMAND=npx
# CODEBUDDY_CLI_ARGS=-y @tencent-ai/codebuddy-code --acp
#
# GOOSE_CLI_COMMAND=goose
# GOOSE_CLI_ARGS=acp
